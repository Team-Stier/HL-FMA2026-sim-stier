Panels:
-   Class: rviz_common/Displays
    Name: Displays
-   Class: rviz_common/Views
    Name: Views
Visualization Manager:
    Class: ''
    Global Options:
        Fixed Frame: map
        Frame Rate: 30
        Background Color: 30; 30; 30
    Displays:
    -   Class: visualization/Aerial
        Name: Source aerial (OSGB XY projection)
        Enabled: true
        Topic:
            Value: /visualization/aerial
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Durability Policy: Transient Local
    -   Class: visualization/HUD
        Name: HUD
        Enabled: true
    -   Class: visualization/SnapshotMarkerArray
        Name: Ego
        Enabled: true
        Topic:
            Value: /visualization/ego
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: visualization/SnapshotMarkerArray
        Name: Objects
        Enabled: true
        Topic:
            Value: /visualization/objects
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_common/Group
        Name: Signals
        Enabled: true
        Displays:
        -   Class: visualization/StaticMarkerArray
            Name: Static local reference
            Enabled: true
            Topic:
                Value: /visualization/signals_static
                Depth: 1
                History Policy: Keep Last
                Reliability Policy: Reliable
                Durability Policy: Transient Local
        -   Class: visualization/SnapshotMarkerArray
            Name: Observed controller
            Enabled: true
            Topic:
                Value: /visualization/signals_observed
                Depth: 1
                History Policy: Keep Last
                Reliability Policy: Best Effort
                Durability Policy: Volatile
    -   Class: visualization/StaticMarkerArray
        Name: Map local reference
        Enabled: true
        Topic:
            Value: /visualization/map
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Durability Policy: Transient Local
    -   Class: visualization/StaticMarkerArray
        Name: Cells local reference
        Enabled: true
        Topic:
            Value: /visualization/cells
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Reliable
            Durability Policy: Transient Local
    -   Class: visualization/SnapshotMarkerArray
        Name: Global path local reference
        Enabled: true
        Topic:
            Value: /visualization/global_path
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: visualization/CellColors
        Name: Occupancy
        Enabled: true
        Topic:
            Value: /visualization/occupancy_colors
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: visualization/CellColors
        Name: Cell speed caps
        Enabled: true
        Topic:
            Value: /visualization/cell_cap_colors
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: visualization/SnapshotMarkerArray
        Name: Search tree
        Enabled: true
        Topic:
            Value: /visualization/search_tree
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: visualization/SnapshotMarkerArray
        Name: tracker cell queries
        Enabled: true
        Topic:
            Value: /debug/tracker/cell_queries
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: visualization/SnapshotMarkerArray
        Name: planner cell queries
        Enabled: true
        Topic:
            Value: /debug/planner/cell_queries
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: visualization/SnapshotMarkerArray
        Name: annotator cell queries
        Enabled: true
        Topic:
            Value: /debug/annotator/cell_queries
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/TF
        Name: TF
        Enabled: true
    -   Class: rviz_default_plugins/Path
        Name: Local path
        Enabled: true
        Topic:
            Value: /local_path
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
        Buffer Length: 1
        Offset:
            X: 0
            Y: 0
            Z: 0
        Color: 255; 60; 180
        Line Style: Billboards
        Line Width: 0.15
    Views:
        Current:
            Class: visualization/IdleFollow
            Name: Mouse navigation + idle Ego follow
            Target Frame: map
            Scale: 27.0
            Angle: -1.5707963267948966
            X: 805.6425274103005
            Y: 26.2605036022312
            Follow After Idle: 10.0
        Saved:
        -   Class: visualization/IdleFollow
            Name: Mouse navigation + idle Ego follow
            Target Frame: map
            Scale: 27.0
            Angle: -1.5707963267948966
            X: 805.6425274103005
            Y: 26.2605036022312
            Follow After Idle: 10.0
    Tools:
    -   Class: rviz_default_plugins/MoveCamera
Window Geometry:
    Width: 1500
    Height: 950

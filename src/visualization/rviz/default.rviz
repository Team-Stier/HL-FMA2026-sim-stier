Panels:
-   Class: rviz_common/Displays
    Name: Displays
-   Class: rviz_common/Views
    Name: Views
Visualization Manager:
    Class: ''
    Global Options:
        Fixed Frame: map
        Frame Rate: 30
        Background Color: 30; 30; 30
    Displays:
    -   Class: rviz_default_plugins/MarkerArray
        Name: Source status
        Enabled: true
        Topic:
            Value: /visualization/status
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Ego
        Enabled: true
        Topic:
            Value: /visualization/ego
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Ego status
        Enabled: false
        Topic:
            Value: /visualization/ego_status
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Objects
        Enabled: true
        Topic:
            Value: /visualization/objects
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Signals
        Enabled: true
        Topic:
            Value: /visualization/signals
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Map local reference
        Enabled: true
        Topic:
            Value: /visualization/map
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Cells local reference
        Enabled: true
        Topic:
            Value: /visualization/cells
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Global path local reference
        Enabled: true
        Topic:
            Value: /visualization/global_path
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Occupancy
        Enabled: true
        Topic:
            Value: /visualization/occupancy
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Cell speed caps
        Enabled: false
        Topic:
            Value: /visualization/cell_cap
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Speed limit
        Enabled: false
        Topic:
            Value: /visualization/speed_limit
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Control requested
        Enabled: false
        Topic:
            Value: /visualization/control
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: Search tree
        Enabled: true
        Topic:
            Value: /visualization/search_tree
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: tracker cell queries
        Enabled: true
        Topic:
            Value: /debug/tracker/cell_queries
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: planner cell queries
        Enabled: true
        Topic:
            Value: /debug/planner/cell_queries
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/MarkerArray
        Name: annotator cell queries
        Enabled: true
        Topic:
            Value: /debug/annotator/cell_queries
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
    -   Class: rviz_default_plugins/TF
        Name: TF
        Enabled: true
    -   Class: rviz_default_plugins/Path
        Name: Local path
        Enabled: true
        Topic:
            Value: /local_path
            Depth: 1
            History Policy: Keep Last
            Reliability Policy: Best Effort
            Durability Policy: Volatile
        Buffer Length: 1
        Offset:
            X: 0
            Y: 0
            Z: 0
        Color: 255; 60; 180
        Line Style: Billboards
        Line Width: 0.15
    Views:
        Current:
            Class: rviz_default_plugins/TopDownOrtho
            Name: Top down
            Target Frame: base_link
            Scale: 5.0
            Angle: -1.5707963267948966
            X: 0.0
            Y: 0.0
Window Geometry:
    Width: 1500
    Height: 950

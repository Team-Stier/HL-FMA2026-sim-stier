<?xml version="1.0"?>
<package format="3">
  <name>path_planner</name>
  <version>0.1.0</version>
  <description>Lanelet global routing with Frenet planning and a kinematic route-follow fallback</description>
  <maintainer email="ppong030206@gmail.com">stier</maintainer>
  <license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>boost</depend>
  <depend>interfaces</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>lanelet2_core</depend>
  <depend>lanelet2_io</depend>
  <depend>lanelet2_routing</depend>
  <depend>lanelet2_traffic_rules</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
